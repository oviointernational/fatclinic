# Dependencies
node_modules/

# Production build output
dist/
dist-ssr/

# Runtime logs
dev.log
*.log
npm-debug.log*

# Environment & secrets
# .env holds SUPABASE_SERVICE_ROLE_KEY, so it stays out of git.
.env
.env.local
.env.*.local
# .env.production is deliberately NOT ignored: it holds only the project URL and
# the public anon key, and committing it is what lets Cloudflare build with no
# dashboard setup. It must never contain the service_role key.

# Editor & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local Vite cache
node_modules/.vite/

# Wrangler local dev state (miniflare sqlite caches and build temp)
.wrangler/

# Supabase CLI local state (linked project ref, cached CLI version)
supabase/.temp/
