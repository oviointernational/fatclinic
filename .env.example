# ============================================================================
# FatClinic EHR — environment template. Copy to .env and fill in.
# .env is gitignored. Never commit real values.
# ============================================================================

# --- 1. Postgres connection (ADMIN MACHINE ONLY) -------------------------------
# Only the `npm run db:*` scripts use this. The browser never connects to
# Postgres directly - it goes through PostgREST (section 2) with the anon key.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
#
# Use the SEPARATE PG* form below, not a postgresql:// URL. A generated password
# usually contains characters that are reserved in a URI (@ # / :), and pasting it
# into a connection string truncates or mis-parses it - the error then looks like
# a DNS failure for a nonsense hostname. Separate values have no such trap.
#
# WHICH HOST? The "Direct connection" row (port 5432, user "postgres") is
# preferred, because it is a plain Postgres connection and needs no PgBouncer.
# However, a Supabase direct host is often IPv6-ONLY, so if this machine has no
# IPv6 route you will get "connect ENETUNREACH" or a connect timeout. In that
# case use the "Session pooler" row instead: it is IPv4 and reachable, but the
# username is "postgres.<project-ref>" and the port is usually 5432 or 6543.
# Both forms work for applying the schema.
#
# To check which one you can reach:
#   Resolve-DnsName <host>
# An "AAAA"-only answer means IPv6-only; "A" means IPv4 is available.
# Never send any of this to the browser.
PGHOST=db.[YOUR-REF].supabase.co
PGPORT=5432
PGUSER=postgres
# WRAP THE PASSWORD IN SINGLE QUOTES. dotenv treats an unquoted "#" as the start
# of a comment and silently truncates the value there, which then fails as a
# misleading "password authentication failed". Single quotes are literal, so
# @ # / : and spaces are all safe inside them.
PGPASSWORD='[YOUR-DATABASE-PASSWORD]'
PGDATABASE=postgres

# Only needed if your host is not a full URL (for example on a PaaS that injects
# DATABASE_URL for you). Ignored when the PG* values above are present.
# DATABASE_URL=postgresql://postgres:...@db.[YOUR-REF].supabase.co:5432/postgres

# SSL is automatic (on for public hosts like Supabase, off for localhost).
# Override only if needed: PG_SSL=true or PG_SSL=false.
# PG_SSL=false


# --- 2. Browser Supabase client ----------------------------------------------
# Supabase dashboard -> Project Settings -> API
#
# These two ARE baked into the public JS bundle, which is expected: the anon key
# is meant to be public. It is only safe because section 12 of
# database/fatclinic.sql enables Row Level Security on every table. Do NOT remove
# RLS, and do NOT leave email self-signup switched on.
#
# When deploying to Cloudflare, set these as build-time env vars on the project
# (they are read at build time, not at runtime).
VITE_SUPABASE_URL=https://[YOUR-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-ANON-OR-PUBLISHABLE-KEY]


# --- 3. Staff provisioning (ADMIN MACHINE ONLY) -------------------------------
# Supabase dashboard -> Project Settings -> API -> service_role -> Reveal.
#
# The `npm run staff:*` commands are the only thing that needs this. It creates
# and disables sign-in accounts, which no browser can do, because it bypasses
# Row Level Security completely.
#
# DO NOT put this in the Cloudflare Pages project, not in any VITE_ variable, and
# not in a commit. VITE_ variables are inlined into the published JavaScript, and
# this key reads and writes every table regardless of policy.
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

