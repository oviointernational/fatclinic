# ============================================================================
# FatClinic EHR — environment template. Copy to .env and fill in.
# .env is gitignored. Never commit real values.
# ============================================================================

# --- 1. Postgres connection string (SERVER-SIDE ONLY) -------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the DIRECT connection (port 5432), NOT the pooler, for the first apply.
# Used by server/index.js and by the schema scripts. Never sent to the browser.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# SSL is automatic (on for public hosts like Supabase, off for localhost).
# Override only if needed: PG_SSL=true or PG_SSL=false.
# PG_SSL=false

# Port is provided by most hosts automatically; local default is 3001.
# PORT=3001


# --- 2. Browser Supabase client ----------------------------------------------
# Supabase dashboard -> Project Settings -> API
#
# These two ARE baked into the public JS bundle, which is expected: the anon key
# is meant to be public. It is only safe because database/rls.sql enables Row
# Level Security on every table. Do NOT remove RLS.
#
# When deploying to Cloudflare, set these as build-time env vars on the project
# (they are read at build time, not at runtime).
VITE_SUPABASE_URL=https://[YOUR-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-ANON-OR-PUBLISHABLE-KEY]


# --- 3. Optional: Node API base URL -------------------------------------------
# If server/index.js is deployed separately, the SPA needs its absolute URL.
# Leave unset to use same-origin /api (local Vite proxy, or a Worker route).
# VITE_API_URL=https://your-api.example.com
