# Railway Postgres wiring.
# In the Railway dashboard, add a variable to this service referencing the
# Postgres service, e.g. value: ${{ Postgres.DATABASE_URL }}
# (use the exact service name of your Postgres plugin).
DATABASE_URL=${{ Postgres.DATABASE_URL }}

# Optional private-network URL (used only if DATABASE_URL is unset).
# DATABASE_PRIVATE_URL=${{ Postgres.DATABASE_PRIVATE_URL }}

# Set to "true" only if your Postgres requires SSL.
PG_SSL=false

# Port is provided by Railway automatically; local default is 3001.
# PORT=3001
