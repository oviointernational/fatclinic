# Railway Postgres wiring (any ONE of these; first set one wins).
# In the Railway dashboard, add a variable to this service referencing the
# Postgres service (use its exact service name). Examples:
DATABASE_URL=${{ Postgres.DATABASE_URL }}
# DATABASE_PUBLIC_URL=${{ Postgres.DATABASE_URL }}
# DATABASE_PRIVATE_URL=${{ Postgres.DATABASE_PRIVATE_URL }}

# SSL is automatic (on for public hosts, off for railway.internal/localhost).
# Override only if needed: PG_SSL=true or PG_SSL=false.
# PG_SSL=false

# Port is provided by Railway automatically; local default is 3001.
# PORT=3001
