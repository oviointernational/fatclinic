# Public build values, committed on purpose.
#
# These two are NOT secrets, and committing them is what lets Cloudflare build
# the site with no setup at all: push, and it deploys. Nothing to click first.
#
#   VITE_SUPABASE_URL      just a hostname
#   VITE_SUPABASE_ANON_KEY designed to be public - it ships inside the
#                          JavaScript that every browser downloads
#
# The anon key is safe in a public bundle for one reason only: Row Level
# Security is enabled and forced on every table, so this key cannot read or
# write a patient record by itself. If RLS were ever turned off, this file
# would be a serious problem. Keep that in mind before changing the schema.
#
# DO NOT ADD SUPABASE_SERVICE_ROLE_KEY TO THIS FILE.
# That key bypasses RLS completely, and every VITE_ value here is inlined into
# published JavaScript. It belongs in .env on an administrator's machine only,
# which is gitignored.
#
# .env still overrides this file when it exists, so a local build can point at a
# different project without editing anything committed.

VITE_SUPABASE_URL=https://pltcaelohphezknpxpdj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBsdGNhZWxvaHBoZXprbnB4cGRqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA0MTg2OTgsImV4cCI6MjEwNTk5NDY5OH0.olavKd8pNnizuTWCyPvZRMJh4-HQV332mnyQf1o3phY
